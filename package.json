{
  "name": "frugrade-web",
  "version": "0.1.0",
  "private": true,
  "description": "FruGrade - front-end klasifikasi jenis & kesegaran buah berbasis CNN",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./assets/css/app.css --minify",
    "watch": "tailwindcss -i ./src/input.css -o ./assets/css/app.css --watch",
    "serve": "python -m http.server 4321",
    "dev": "npm run build && npm run serve"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  },
  "dependencies": {
    "gsap": "3.12.5"
  }
}
